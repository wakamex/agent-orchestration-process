// The documentation site, served as Workers static assets.
{
  "name": "agent-orchestration-process",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./docs-site/public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "agentorchestrationprocess.com", "custom_domain": true },
    { "pattern": "www.agentorchestrationprocess.com", "custom_domain": true }
  ]
}
